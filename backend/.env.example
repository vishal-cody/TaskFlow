# ── Server ──
SERVER_PORT=8080
SHUTDOWN_TIMEOUT_SECONDS=30

# ── Database ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobplatform?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MINUTES=30

# ── JWT ──
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-secure-secret-in-production-at-least-32-chars
JWT_EXPIRY_SECONDS=3600

# ── Logging ──
LOG_LEVEL=debug

# ── RabbitMQ (Phase 2) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Redis (Phase 4) ──
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
